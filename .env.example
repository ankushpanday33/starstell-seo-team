# StarsTell SEO Team: environment variables.
#
# Copy this file to .env and fill in values on the server. NEVER commit .env:
# this repository is public. .env is already git-ignored.
#
# Nothing here is needed to run the agent office visualizer today
# (node visualizer/starstell-office.mjs). Everything below is for the real system,
# and each line says which phase needs it.
#
# Names marked "placeholder" are not final: they are confirmed against the
# StarsTell API and CMS documentation before any integration code is written.

# ---------------------------------------------------------------- Phase 1: core

# Anthropic API key for the agents (Claude). Paperclip passes it to agent runs.
# Get it: console.anthropic.com > API keys.
ANTHROPIC_API_KEY=

# PostgreSQL for the Content Service (Paperclip and OpenSEO keep their own databases).
# Example: postgres://starstell:CHANGE_ME@localhost:5432/starstell_content
DATABASE_URL=

# ---------------------------------------------------------------- Phase 1: OpenSEO (SEO data)
# OpenSEO reads these from its own .env when it is self-hosted.

# DataForSEO account: keyword volumes, SERPs, competitors, backlinks, rank tracking.
# Get it: dataforseo.com > API access. Pay per call.
DATAFORSEO_API_KEY=

# OpenSEO sign-in mode for a self-hosted Docker install ("password" = email and password accounts).
AUTH_MODE=password
# Long random secret (32+ characters); also encrypts the stored Google tokens.
BETTER_AUTH_SECRET=
# Public URL of the OpenSEO install, e.g. https://seo.internal.example.com
BETTER_AUTH_URL=

# ---------------------------------------------------------------- Phase 1: Google (Search Console, GA4)
# A Google Cloud OAuth client, used by OpenSEO to read Search Console and GA4.
# Get it: console.cloud.google.com > APIs & Services > Credentials > OAuth client ID.
# A Search Console owner then grants that account access to the StarsTell property.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------- Phase 2: StarsTell bots (placeholders)
# From the StarsTell team, once the API documentation is shared.
STARSTELL_VEDIC_API_URL=
STARSTELL_VEDIC_API_KEY=
STARSTELL_TAROT_API_URL=
STARSTELL_TAROT_API_KEY=
STARSTELL_NUMEROLOGY_API_URL=
STARSTELL_NUMEROLOGY_API_KEY=

# ---------------------------------------------------------------- Phase 2: image model (placeholders)
# Two models are tested in Phase 2; only the winner's key stays.
GOOGLE_AI_API_KEY=
OPENAI_API_KEY=

# ---------------------------------------------------------------- Phase 3: publishing (placeholders)
# StarsTell CMS API, once the CMS is confirmed.
STARSTELL_CMS_API_URL=
STARSTELL_CMS_API_KEY=

# IndexNow key: any random 8 to 128 character string; the same value is served at
# https://<site>/<key>.txt so search engines can verify it.
INDEXNOW_KEY=

# ---------------------------------------------------------------- Score gate (Seryvon, see scoring/README.md)
# A draft reaches the CMS only if SEO, GEO and AEO each score this or more.
STARSTELL_SCORE_THRESHOLD=90
# Minimum share of each pillar's criteria that must be measured for a score to count.
STARSTELL_MIN_COVERAGE=0.45
# Private preview hosts the gate may score (Seryvon blocks private addresses otherwise).
STARSTELL_PREVIEW_HOSTS=127.0.0.1
# Optional keys that let Seryvon measure more criteria:
# PageSpeed Insights: Core Web Vitals
PSI_API_KEY=
# Search Console, used by the weekly site run
GSC_SERVICE_ACCOUNT=
# AI citation tracking (GEO); Seryvon also reads OPENAI_API_KEY and ANTHROPIC_API_KEY
GEMINI_API_KEY=
PERPLEXITY_API_KEY=

# ---------------------------------------------------------------- Optional: agent office visualizer
# Only these two are read by visualizer/starstell-office.mjs. No credentials needed:
# the office creates its own local write token in ~/.roving-office/endpoint.json.
PORT=8090
SPEED=1
