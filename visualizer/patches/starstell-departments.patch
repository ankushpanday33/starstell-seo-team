diff --git a/src/starstell/departments.js b/src/starstell/departments.js
new file mode 100644
index 0000000..9faefca
--- /dev/null
+++ b/src/starstell/departments.js
@@ -0,0 +1,86 @@
+// StarsTell departments: which desks belong to which team, and the coloured floor
+// areas with labels that mark them. Added for the StarsTell SEO office; the desk ids
+// match visualizer/starstell-layout.json in the starstell-seo-team repository.
+
+import * as THREE from 'three';
+import { FLOOR_TOP } from '../config.js';
+
+export const DEPARTMENTS = [
+  { id: 'hq', name: 'Paperclip HQ', sub: 'Tasks · approvals · budgets', color: '#E0BF71',
+    area: [0.6, 3.6, 10.2, 10.6], desks: ['desk-1'] },
+  { id: 'research', name: 'SEO Research', sub: 'Keywords · competitors · OpenSEO', color: '#5B6C8F',
+    area: [10.6, 0.6, 22.6, 10.6], desks: ['desk-2', 'desk-3', 'desk-4', 'desk-5'] },
+  { id: 'knowledge', name: 'Knowledge', sub: 'Vedic · Tarot · Numerology bots', color: '#7A5A9A',
+    area: [23.0, 0.6, 35.4, 10.6], desks: ['desk-6', 'desk-7', 'desk-8', 'desk-9'] },
+  { id: 'writing', name: 'Writing Room', sub: 'Draft · fact check · SEO · edit', color: '#A45B3E',
+    area: [0.6, 12.0, 13.2, 25.4], desks: ['desk-10', 'desk-11', 'desk-12', 'desk-13'] },
+  { id: 'languages', name: 'Language Desk', sub: 'Hindi · Hinglish · Marathi · Tamil · Telugu · Bengali', color: '#C77A3A',
+    area: [13.6, 12.0, 28.6, 25.4], desks: ['desk-14', 'desk-15', 'desk-16', 'desk-17', 'desk-18', 'desk-19'] },
+  { id: 'publish', name: 'Design · Publish · Results', sub: 'Images · CMS · Search Console', color: '#2F6F8F',
+    area: [29.0, 12.0, 35.4, 25.4], desks: ['desk-20', 'desk-21', 'desk-22'] },
+];
+
+const BY_ID = new Map(DEPARTMENTS.map((d) => [d.id, d]));
+
+/** The desk ids a department sits at, or null for an agent with no department. */
+export function deskIdsFor(department) {
+  return BY_ID.get(department)?.desks ?? null;
+}
+
+function labelTexture(title, sub, color) {
+  const c = document.createElement('canvas');
+  c.width = 1024; c.height = 256;
+  const g = c.getContext('2d');
+  g.fillStyle = color;
+  g.fillRect(0, 0, 14, 256);
+  g.fillStyle = '#2A0A03';
+  g.font = 'bold 92px Arial, sans-serif';
+  g.textBaseline = 'top';
+  g.fillText(title, 40, 30);
+  g.font = '54px Arial, sans-serif';
+  g.fillStyle = '#421206';
+  g.fillText(sub, 40, 150);
+  const tex = new THREE.CanvasTexture(c);
+  tex.colorSpace = THREE.SRGBColorSpace;
+  tex.anisotropy = 4;
+  return tex;
+}
+
+/** Coloured floor areas and a floor label per department, added to the world root. */
+export function addDepartmentFloors(root) {
+  const group = new THREE.Group();
+  group.name = 'starstell-departments';
+  for (const d of DEPARTMENTS) {
+    const [x0, z0, x1, z1] = d.area;
+    const w = x1 - x0;
+    const h = z1 - z0;
+    const floor = new THREE.Mesh(
+      new THREE.PlaneGeometry(w, h),
+      new THREE.MeshBasicMaterial({ color: d.color, transparent: true, opacity: 0.16, depthWrite: false }),
+    );
+    floor.rotation.x = -Math.PI / 2;
+    floor.position.set(x0 + w / 2, FLOOR_TOP + 0.012, z0 + h / 2);
+    floor.renderOrder = 1;
+    group.add(floor);
+
+    const edge = new THREE.LineSegments(
+      new THREE.EdgesGeometry(new THREE.PlaneGeometry(w, h)),
+      new THREE.LineBasicMaterial({ color: d.color }),
+    );
+    edge.rotation.x = -Math.PI / 2;
+    edge.position.copy(floor.position).setY(FLOOR_TOP + 0.02);
+    group.add(edge);
+
+    const lw = Math.min(w - 0.6, 7.2);
+    const label = new THREE.Mesh(
+      new THREE.PlaneGeometry(lw, lw / 4),
+      new THREE.MeshBasicMaterial({ map: labelTexture(d.name, d.sub, d.color), transparent: true, depthWrite: false }),
+    );
+    label.rotation.x = -Math.PI / 2;
+    label.position.set(x0 + 0.3 + lw / 2, FLOOR_TOP + 0.03, z1 - 0.3 - lw / 8);
+    label.renderOrder = 2;
+    group.add(label);
+  }
+  root.add(group);
+  return group;
+}
